# Copy this file to backend/.env. backend/.env is git-ignored: never commit it.
# Real environment variables win over this file.

# --- PLM sign-in (HTTP authentication, applied to every page) ---
PLM_USER=
PLM_PASSWORD=

# Windchill home page (default shown).
# PLM_URL=https://plm-mc-12.myatlantic.aero/Windchill/app/

# How long the run waits for the search box (i.e. for a manual sign-in), in ms (default 300000).
# LOGIN_WAIT_MS=300000

# Use the browser already installed instead of downloading Chromium (needed behind the
# company proxy, where "npm run setup:browsers" fails with "unable to get local issuer certificate").
# BROWSER_CHANNEL=chrome
# BROWSER_CHANNEL=msedge

# Routings processed side by side (default 4). Use 1 if PLM struggles.
# WORKERS=4

# Title (start of it) of the column of the Uses table that receives the value (default shown).
# DHT_COLUMN_HEADER=Temps Traite

# --- The file ---
# Sheet to read (default: the first sheet with a routing and an operation column).
# SHEET_NAME=CZJ790
# Column of the DHT value (letter or header name; default E), routing and operation columns.
# DHT_COLUMN=E
# ROUTING_COLUMN=Gamme
# OP_COLUMN=Opération
# Terminal runs read this file (default inputs/inputData.xlsx).
# INPUT_FILE=inputs/inputData.xlsx

# Process only the first N rows, to try a change on a small sample.
# MAX_ROUTINGS=3

# Spec a run executes (default shown).
# PLAYWRIGHT_SPEC=tests/dht-update.spec.ts

# Integrate is NOT implemented on purpose: the run stops right before that step until
# Airbus Atlantic has cleared it.
